// CytoHub CEO Command Center — relational data model.
//
// Shape of the domain:
//   StrategicPillar → Goal → Milestone → Task
//   Decision / Resource / Note / Activity attach to the execution graph.
//   Person ↔ Company, Deal, Meeting describe the outside world.
//   BrainSource → BrainSignal → BrainInsight → (InboxItem | Task | DailyBrief)
//   is the CytoHub Brain pipeline: ingest → understand → act.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum GoalType {
  COMPANY
  ANNUAL
  QUARTERLY
  CEO
  DEPARTMENT
}

enum GoalStatus {
  ON_TRACK
  AT_RISK
  OFF_TRACK
  COMPLETED
  PAUSED
}

enum MilestoneType {
  ARR
  PHARMA_CONTRACT
  FUNDRAISING
  PRODUCT_RELEASE
  AI_MODEL
  SCIENTIFIC_VALIDATION
  PUBLICATION
  REGULATORY
  PARTNERSHIP
  HIRING
  THERAPEUTIC
  OTHER
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  AT_RISK
  BLOCKED
  COMPLETED
  MISSED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  WAITING
  BLOCKED
  DONE
  CANCELLED
  SOMEDAY
}

enum Priority {
  P0
  P1
  P2
  P3
}

/// Where CEO attention goes. Used for tasks, meetings and time allocation.
enum FocusArea {
  FUNDRAISING
  REVENUE
  CUSTOMERS
  PRODUCT
  CYTOHUB_AI
  SCIENCE
  PARTNERSHIPS
  TEAM
  FINANCE
  OPERATIONS
  LEGAL
  RECRUITING
  STRATEGY
  CEO_DEVELOPMENT
}

enum ItemSource {
  MANUAL
  BRAIN
  EMAIL
  CALENDAR
  CRM
  MEETING
  DOCUMENT
  DECISION
  INBOX
}

enum DecisionStatus {
  NEEDED
  WAITING_INFO
  DECIDED
  DEFERRED
}

enum ResourceType {
  DOCUMENT
  PRESENTATION
  CONTRACT
  FINANCIAL_MODEL
  MEETING_NOTES
  SCIENTIFIC_PAPER
  DATASET
  LINK
  INTELLIGENCE
  OTHER
}

enum PersonType {
  TEAM
  INVESTOR
  CUSTOMER
  PARTNER
  ADVISOR
  BOARD
  CANDIDATE
  OTHER
}

enum CompanyType {
  CUSTOMER
  PROSPECT
  INVESTOR
  PARTNER
  ACADEMIC
  VENDOR
  COMPETITOR
  OTHER
}

enum DealType {
  SALES
  FUNDRAISING
  PARTNERSHIP
}

enum DealStatus {
  OPEN
  WON
  LOST
  ON_HOLD
}

enum MeetingType {
  INVESTOR
  CUSTOMER
  BOARD
  PARTNER
  INTERNAL
  ONE_ON_ONE
  CANDIDATE
  EXTERNAL
}

enum MetricCategory {
  REVENUE
  ARR
  PIPELINE
  CUSTOMERS
  FUNDRAISING
  CASH
  PRODUCT
  AI
  SCIENCE
  THERAPEUTICS
  PARTNERSHIPS
  TEAM
}

enum MetricUnit {
  CURRENCY
  PERCENT
  COUNT
  NUMBER
  MONTHS
  DAYS
}

enum MetricDirection {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER
}

enum DelegationStatus {
  ACTIVE
  NEEDS_FOLLOW_UP
  COMPLETED
  RECALLED
}

enum InboxType {
  APPROVAL
  DECISION
  RESPONSE
  ESCALATION
  CUSTOMER_ISSUE
  INVESTOR_FOLLOW_UP
  DEADLINE_RISK
  HIRING_DECISION
  OPPORTUNITY
  COMMITMENT
  CHANGE
  REQUEST
}

enum InboxStatus {
  OPEN
  SNOOZED
  DONE
  DISMISSED
}

enum InsightType {
  DEVELOPMENT
  OPPORTUNITY
  RISK
  DEAL_PROGRESS
  DEAL_SLOWING
  COMMUNICATION
  MILESTONE_REACHED
  MILESTONE_AT_RISK
  DECISION_NEEDED
  DEADLINE
  FOLLOW_UP
  COMMITMENT
  DELEGATION
  ATTENTION
  CHANGE
}

enum InsightStatus {
  NEW
  ACKNOWLEDGED
  ACTIONED
  DISMISSED
}

enum RefreshStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum RefreshTrigger {
  MANUAL
  SCHEDULED
  SEED
}

enum SourceCategory {
  WORKSPACE
  COMMUNICATION
  CALENDAR
  CRM
  DOCUMENTS
  FINANCE
  SCIENCE
  PEOPLE
}

enum SourceStatus {
  CONNECTED
  NOT_CONNECTED
  SYNCING
  ERROR
  DISABLED
}

enum SignalKind {
  EMAIL
  CALENDAR_EVENT
  CRM_UPDATE
  DOCUMENT
  MEETING_NOTE
  METRIC_UPDATE
  MESSAGE
  MANUAL
}

enum ActivityType {
  TASK_CREATED
  TASK_UPDATED
  TASK_COMPLETED
  TASK_REOPENED
  TASK_RESCHEDULED
  TASK_DELEGATED
  TASK_PRIORITY_CHANGED
  NOTE_ADDED
  GOAL_CREATED
  GOAL_UPDATED
  MILESTONE_CREATED
  MILESTONE_UPDATED
  MILESTONE_COMPLETED
  DECISION_CREATED
  DECISION_UPDATED
  DECISION_MADE
  RESOURCE_ADDED
  INBOX_RESOLVED
  DELEGATION_UPDATED
  METRIC_RECORDED
  MEETING_PREPARED
  BRAIN_REFRESH
  TOP5_CONFIRMED
  END_OF_DAY
  REVIEW_COMPLETED
  SETTINGS_UPDATED
  COMMITMENT_CREATED
  COMMITMENT_UPDATED
  COMMITMENT_FULFILLED
  DEADLINE_CHANGED
  OWNER_CHANGED
  STATUS_CHANGED
  MEETING_OCCURRED
  MEETING_RESCHEDULED
  MEETING_CANCELLED
  DOCUMENT_CHANGED
  RISK_EMERGED
  RISK_RESOLVED
  OPPORTUNITY_IDENTIFIED
  ENTITY_CREATED
  ENTITY_MERGED
  SOURCE_CONNECTED
  SOURCE_DISCONNECTED
  REVIEW_RESOLVED
}

enum ReviewType {
  WEEKLY
  MONTHLY
}

enum PrioritySource {
  BRAIN
  CEO
}

enum TimeSource {
  CALENDAR
  TASK
  MANUAL
}

enum ChatRole {
  USER
  ASSISTANT
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity & configuration
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  title     String   @default("Chief Executive Officer")
  timezone  String   @default("America/New_York")
  /// The Person record representing this user in the execution graph.
  personId  String?  @unique
  person    Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)
  /// Least privilege by default; the seed and admins assign roles explicitly.
  role         UserRole  @default(TEAM_MEMBER)
  /// scrypt hash (see src/server/security/passwords.ts). Null = cannot sign in with a password.
  passwordHash String?
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  /// Set when someone else chose the password (admin create or reset); the
  /// user must replace it before they can use anything else.
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chatThreads     ChatThread[]
  sessions        Session[]
  connections     SourceConnection[]
  grants          AccessGrant[]     @relation("GrantUser")
  grantsGiven     AccessGrant[]     @relation("GrantGrantedBy")
  auditLogs       AuditLog[]
  reviewsAssigned ReviewQueueItem[] @relation("ReviewAssignee")
  reviewsResolved ReviewQueueItem[] @relation("ReviewResolver")
}

/// Key/value configuration (priority weights, thresholds, preferences).
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model StrategicPillar {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  /// Token from the app's pillar palette (e.g. "teal", "indigo").
  color       String   @default("slate")
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  goals      Goal[]
  milestones Milestone[]
  tasks      Task[]
  decisions  Decision[]
  metrics    Metric[]
  projects   Project[]
}

/// Recommended share of CEO attention per focus area. Configurable by the CEO.
model AttentionTarget {
  focusArea      FocusArea @id
  recommendedPct Float
  rationale      String?
  updatedAt      DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// People & companies
// ─────────────────────────────────────────────────────────────────────────────

model Company {
  id             String      @id @default(cuid())
  name           String      @unique
  type           CompanyType
  industry       String?
  website        String?
  description    String?
  location       String?
  /// 1 (cold) – 5 (strong). Updated by the Brain from interaction history.
  relationship   Int         @default(3)
  lastActivityAt DateTime?
  /// Primary email domain, used by entity resolution (more live in EntityAlias).
  domain         String?
  /// Corporate family: e.g. Janssen → Johnson & Johnson.
  parentId       String?
  parent         Company?    @relation("CompanyFamily", fields: [parentId], references: [id], onDelete: SetNull)
  subsidiaries   Company[]   @relation("CompanyFamily")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  threads       EmailThread[]
  documents     Document[]
  commitments   Commitment[]
  risks         Risk[]
  opportunities Opportunity[]
  people      Person[]
  deals       Deal[]
  tasks       Task[]
  meetings    Meeting[]
  insights    BrainInsight[]
  inboxItems  InboxItem[]
  notes       Note[]
  activities  Activity[]
  signals     BrainSignal[]
  resources   Resource[]     @relation("ResourceCompanies")
  decisions   Decision[]     @relation("DecisionCompanies")
}

model Person {
  id            String     @id @default(cuid())
  name          String
  email         String?    @unique
  title         String?
  type          PersonType
  isCeo         Boolean    @default(false)
  department    String?
  /// Focus areas this person can own; used for delegation recommendations.
  expertise     FocusArea[]
  companyId     String?
  company       Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  lastContactAt DateTime?
  notesText     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user               User?
  ownedGoals         Goal[]         @relation("GoalOwner")
  ownedMilestones    Milestone[]    @relation("MilestoneOwner")
  ownedTasks         Task[]         @relation("TaskOwner")
  suggestedForTasks  Task[]         @relation("TaskSuggestedDelegate")
  relatedTasks       Task[]         @relation("TaskPeople")
  ownedDecisions     Decision[]     @relation("DecisionOwner")
  delegationsIn      Delegation[]   @relation("DelegationDelegate")
  ownedDeals         Deal[]         @relation("DealOwner")
  meetings           Meeting[]      @relation("MeetingAttendees")
  insights           BrainInsight[]
  inboxItems         InboxItem[]
  notes              Note[]
  activities         Activity[]
  signals            BrainSignal[]
  resources          Resource[]     @relation("ResourcePeople")

  commitmentsOwned Commitment[]  @relation("CommitmentOwner")
  commitmentsOwed  Commitment[]  @relation("CommitmentCounterparty")
  risksOwned       Risk[]        @relation("RiskOwner")
  opportunities    Opportunity[] @relation("OpportunityContact")

  @@index([type])
  @@index([companyId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Strategy & execution graph
// ─────────────────────────────────────────────────────────────────────────────

model Goal {
  id          String     @id @default(cuid())
  title       String
  description String?
  type        GoalType
  status      GoalStatus @default(ON_TRACK)
  /// 0–100
  progress    Int        @default(0)
  /// 0–100, the owner's confidence the goal will be achieved on time.
  confidence  Int        @default(70)
  department  String?
  /// e.g. "2026-Q4" for quarterly goals.
  period      String?
  startDate   DateTime?  @db.Date
  targetDate  DateTime?  @db.Date
  risks       String?
  notesText   String?
  pillarId    String?
  pillar      StrategicPillar? @relation(fields: [pillarId], references: [id], onDelete: SetNull)
  ownerId     String?
  owner       Person?    @relation("GoalOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  parentId    String?
  parent      Goal?      @relation("GoalHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Goal[]     @relation("GoalHierarchy")
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  milestones Milestone[]
  tasks      Task[]
  decisions  Decision[]
  metrics    Metric[]
  meetings   Meeting[]
  insights   BrainInsight[]
  inboxItems InboxItem[]
  notes      Note[]
  activities Activity[]
  resources  Resource[]  @relation("ResourceGoals")
  commitments   Commitment[]
  riskRecords   Risk[]
  opportunities Opportunity[]
  projects      Project[]

  @@index([type, status])
  @@index([pillarId])
}

model Milestone {
  id            String          @id @default(cuid())
  title         String
  description   String?
  type          MilestoneType
  status        MilestoneStatus @default(PLANNED)
  /// 0–100
  progress      Int             @default(0)
  dueDate       DateTime        @db.Date
  completedAt   DateTime?
  blocker       String?
  /// Free-form success criterion, e.g. "Signed MSA ≥ $1.2M".
  successMetric String?
  goalId        String?
  goal          Goal?           @relation(fields: [goalId], references: [id], onDelete: SetNull)
  pillarId      String?
  pillar        StrategicPillar? @relation(fields: [pillarId], references: [id], onDelete: SetNull)
  ownerId       String?
  owner         Person?         @relation("MilestoneOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  tasks      Task[]
  insights   BrainInsight[]
  notes      Note[]
  activities Activity[]
  resources  Resource[]  @relation("ResourceMilestones")
  risks      Risk[]

  @@index([dueDate])
  @@index([status])
  @@index([goalId])
}

model Task {
  id                 String     @id @default(cuid())
  title              String
  description        String?
  status             TaskStatus @default(TODO)
  priority           Priority   @default(P2)
  focusArea          FocusArea  @default(OPERATIONS)
  dueDate            DateTime?  @db.Date
  /// First due date ever set; lets the Brain detect slippage.
  originalDueDate    DateTime?  @db.Date
  postponeCount      Int        @default(0)
  hardDeadline       Boolean    @default(false)
  completedAt        DateTime?
  estimatedMinutes   Int?
  actualMinutes      Int?
  blocker            String?
  source             ItemSource @default(MANUAL)
  sourceRef          String?
  notesText          String?
  tags               String[]

  // CEO Priority Score inputs (0–5). Urgency and dependency are derived.
  strategicImpact    Int        @default(3)
  revenueImpact      Int        @default(0)
  fundraisingImpact  Int        @default(0)
  customerImpact     Int        @default(0)
  scientificImpact   Int        @default(0)
  riskLevel          Int        @default(1)
  ceoUniqueness      Int        @default(3)
  opportunityCost    Int        @default(2)

  // Brain output (cached, recomputed on every refresh / mutation).
  priorityScore         Float     @default(0)
  scoreBreakdown        Json?
  scoredAt              DateTime?
  aiRecommendation      String?
  /// Set when the task was extracted by CytoHub Brain from a source.
  extractionConfidence  Confidence?
  delegationRecommended Boolean   @default(false)
  suggestedDelegateId   String?
  suggestedDelegate     Person?   @relation("TaskSuggestedDelegate", fields: [suggestedDelegateId], references: [id], onDelete: SetNull)

  ownerId     String?
  owner       Person?          @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  goalId      String?
  goal        Goal?            @relation(fields: [goalId], references: [id], onDelete: SetNull)
  milestoneId String?
  milestone   Milestone?       @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  pillarId    String?
  pillar      StrategicPillar? @relation(fields: [pillarId], references: [id], onDelete: SetNull)
  companyId   String?
  company     Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  decisionId  String?
  decision    Decision?        @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  meetingId   String?
  meeting     Meeting?         @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  dependsOn Task[] @relation("TaskDependencies")
  blocks    Task[] @relation("TaskDependencies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  people          Person[]        @relation("TaskPeople")
  resources       Resource[]      @relation("ResourceTasks")
  delegation      Delegation?
  dailyPriorities DailyPriority[]
  insights        BrainInsight[]
  inboxItems      InboxItem[]
  notes           Note[]
  activities      Activity[]
  timeEntries     TimeEntry[]
  commitment      Commitment?

  @@index([status, dueDate])
  @@index([ownerId])
  @@index([goalId])
  @@index([milestoneId])
  @@index([priorityScore])
  @@index([completedAt])
}

model Decision {
  id             String         @id @default(cuid())
  title          String
  context        String?
  status         DecisionStatus @default(NEEDED)
  raisedAt       DateTime       @default(now())
  deadline       DateTime?      @db.Date
  /// 1–5
  strategicImpact Int           @default(3)
  supportingInfo String?
  recommendation String?
  /// What information the decision is waiting on (WAITING_INFO).
  waitingOn      String?
  finalDecision  String?
  decidedAt      DateTime?
  outcome        String?
  lessonsLearned String?
  goalId         String?
  goal           Goal?            @relation(fields: [goalId], references: [id], onDelete: SetNull)
  pillarId       String?
  pillar         StrategicPillar? @relation(fields: [pillarId], references: [id], onDelete: SetNull)
  ownerId        String?
  owner          Person?          @relation("DecisionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  options    DecisionOption[]
  tasks      Task[]
  companies  Company[]       @relation("DecisionCompanies")
  resources  Resource[]      @relation("ResourceDecisions")
  insights   BrainInsight[]
  inboxItems InboxItem[]
  notes      Note[]
  activities Activity[]

  @@index([status, deadline])
}

model DecisionOption {
  id          String   @id @default(cuid())
  decisionId  String
  decision    Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  title       String
  description String?
  pros        String[]
  cons        String[]
  risks       String[]
  recommended Boolean  @default(false)
  order       Int      @default(0)
}

model Resource {
  id          String       @id @default(cuid())
  title       String
  type        ResourceType
  url         String?
  description String?
  /// Brain-generated summary of the resource contents.
  summary     String?
  tags        String[]
  source      ItemSource   @default(MANUAL)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  goals      Goal[]      @relation("ResourceGoals")
  tasks      Task[]      @relation("ResourceTasks")
  milestones Milestone[] @relation("ResourceMilestones")
  decisions  Decision[]  @relation("ResourceDecisions")
  people     Person[]    @relation("ResourcePeople")
  companies  Company[]   @relation("ResourceCompanies")
  document   Document?

  @@index([type])
}

model Delegation {
  id             String           @id @default(cuid())
  taskId         String           @unique
  task           Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  delegateId     String
  delegate       Person           @relation("DelegationDelegate", fields: [delegateId], references: [id], onDelete: Cascade)
  status         DelegationStatus @default(ACTIVE)
  expectations   String?
  delegatedAt    DateTime         @default(now())
  dueDate        DateTime?        @db.Date
  lastUpdateAt   DateTime?
  lastUpdateNote String?
  followUpAt     DateTime?        @db.Date
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  activities Activity[]

  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Outside world: deals, meetings, metrics
// ─────────────────────────────────────────────────────────────────────────────

model Deal {
  id             String     @id @default(cuid())
  name           String
  type           DealType
  status         DealStatus @default(OPEN)
  stage          String
  stageOrder     Int        @default(0)
  /// Contract value / round contribution in USD.
  value          Float?
  /// 0–100
  probability    Int        @default(20)
  expectedClose  DateTime?  @db.Date
  stageChangedAt DateTime?
  lastActivityAt DateTime?
  nextStep       String?
  companyId      String?
  company        Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  ownerId        String?
  owner          Person?    @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  insights   BrainInsight[]
  inboxItems InboxItem[]
  signals    BrainSignal[]
  threads       EmailThread[]
  commitments   Commitment[]
  risks         Risk[]
  opportunities Opportunity[]

  @@index([type, status])
}

model Meeting {
  id          String      @id @default(cuid())
  title       String
  type        MeetingType
  focusArea   FocusArea   @default(OPERATIONS)
  startsAt    DateTime
  endsAt      DateTime
  location    String?
  description String?
  objective   String?
  /// 1–5; ≥4 qualifies for "Prepare Me".
  importance  Int         @default(3)
  source      ItemSource  @default(CALENDAR)
  externalId  String?     @unique
  companyId   String?
  company     Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  goalId      String?
  goal        Goal?       @relation(fields: [goalId], references: [id], onDelete: SetNull)
  /// Cached Prepare Me brief (see src/server/brain/prepare.ts for shape).
  prepBrief   Json?
  preparedAt  DateTime?
  category    MeetingCategory?
  status      MeetingStatus @default(SCHEDULED)
  /// When post-meeting notes were last run through the ingestion pipeline.
  notesProcessedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  calendarEvent CalendarEvent?
  sourceItems   SourceItem[]
  commitments   Commitment[]
  insights      BrainInsight[]
  attendees   Person[]    @relation("MeetingAttendees")
  tasks       Task[]
  notes       Note[]
  activities  Activity[]
  timeEntries TimeEntry[]

  @@index([startsAt])
}

model Metric {
  id          String          @id @default(cuid())
  key         String          @unique
  name        String
  category    MetricCategory
  unit        MetricUnit
  direction   MetricDirection @default(HIGHER_IS_BETTER)
  description String?
  target      Float?
  targetDate  DateTime?       @db.Date
  /// "manual", or a connector/derivation key such as "derived:pipeline.weighted".
  sourceKey   String          @default("manual")
  order       Int             @default(0)
  pillarId    String?
  pillar      StrategicPillar? @relation(fields: [pillarId], references: [id], onDelete: SetNull)
  goalId      String?
  goal        Goal?           @relation(fields: [goalId], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  values MetricValue[]

  @@index([category])
}

model MetricValue {
  id         String   @id @default(cuid())
  metricId   String
  metric     Metric   @relation(fields: [metricId], references: [id], onDelete: Cascade)
  recordedAt DateTime @db.Date
  value      Float
  note       String?
  source     String   @default("manual")
  createdAt  DateTime @default(now())

  @@unique([metricId, recordedAt])
}

/// A block of CEO time. Sourced from the calendar, task effort or manual logging.
model TimeEntry {
  id          String     @id @default(cuid())
  date        DateTime   @db.Date
  minutes     Int
  focusArea   FocusArea
  source      TimeSource
  description String?
  taskId      String?
  task        Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  meetingId   String?
  meeting     Meeting?   @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([date])
}

// ─────────────────────────────────────────────────────────────────────────────
// CytoHub Brain
// ─────────────────────────────────────────────────────────────────────────────

/// A connector the Brain can ingest from (calendar, email, CRM, docs, …).
model BrainSource {
  id           String         @id @default(cuid())
  key          String         @unique
  name         String
  category     SourceCategory
  status       SourceStatus   @default(NOT_CONNECTED)
  description  String?
  lastSyncAt   DateTime?
  itemsIndexed Int            @default(0)
  error        String?
  config       Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  signals     BrainSignal[]
  connections SourceConnection[]
}

/// A raw, normalized item ingested from a source. Signals are immutable;
/// the analysis stage turns them into insights.
model BrainSignal {
  id          String       @id @default(cuid())
  sourceId    String
  source      BrainSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId  String?
  kind        SignalKind
  title       String
  body        String?
  occurredAt  DateTime
  ingestedAt  DateTime     @default(now())
  processedAt DateTime?
  /// Connector-provided structure (e.g. { stageFrom, stageTo } for CRM updates).
  metadata    Json?
  personId    String?
  person      Person?      @relation(fields: [personId], references: [id], onDelete: SetNull)
  companyId   String?
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  dealId      String?
  deal        Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())

  insights BrainInsight[]

  @@unique([sourceId, externalId])
  @@index([processedAt])
}

model BrainRefresh {
  id             String         @id @default(cuid())
  status         RefreshStatus  @default(RUNNING)
  trigger        RefreshTrigger @default(MANUAL)
  startedAt      DateTime       @default(now())
  completedAt    DateTime?
  durationMs     Int?
  signalsScanned Int            @default(0)
  insightsCreated Int           @default(0)
  tasksCreated   Int            @default(0)
  tasksUpdated   Int            @default(0)
  milestonesChanged Int         @default(0)
  inboxCreated   Int            @default(0)
  /// Per-source sync results: [{ key, status, items, error? }]
  sourceResults  Json?
  /// Stage-by-stage log of the pipeline run.
  log            Json?
  error          String?

  insights BrainInsight[]
  briefs   DailyBrief[]

  @@index([startedAt])
}

model BrainInsight {
  id             String        @id @default(cuid())
  type           InsightType
  status         InsightStatus @default(NEW)
  title          String
  summary        String?
  /// 1–5
  importance     Int           @default(3)
  requiresCeo    Boolean       @default(false)
  recommendation String?
  /// Stable identity so repeated refreshes update instead of duplicating.
  fingerprint    String        @unique
  refreshId      String?
  refresh        BrainRefresh? @relation(fields: [refreshId], references: [id], onDelete: SetNull)
  signalId       String?
  signal         BrainSignal?  @relation(fields: [signalId], references: [id], onDelete: SetNull)
  personId       String?
  person         Person?       @relation(fields: [personId], references: [id], onDelete: SetNull)
  companyId      String?
  company        Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  goalId         String?
  goal           Goal?         @relation(fields: [goalId], references: [id], onDelete: SetNull)
  milestoneId    String?
  milestone      Milestone?    @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  taskId         String?
  task           Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  decisionId     String?
  decision       Decision?     @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  dealId         String?
  deal           Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  sourceItemId   String?
  sourceItem     SourceItem?   @relation(fields: [sourceItemId], references: [id], onDelete: SetNull)
  commitmentId   String?
  commitment     Commitment?   @relation(fields: [commitmentId], references: [id], onDelete: SetNull)
  riskId         String?
  risk           Risk?         @relation(fields: [riskId], references: [id], onDelete: SetNull)
  opportunityId  String?
  opportunity    Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  documentId     String?
  document       Document?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  meetingId      String?
  meeting        Meeting?      @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  /// For CHANGE insights: what changed (e.g. "meeting_rescheduled", "document_figures").
  changeKind     String?
  occurredAt     DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  inboxItems InboxItem[]

  @@index([type, status])
  @@index([createdAt])
}

model DailyBrief {
  id         String        @id @default(cuid())
  /// Calendar day (CEO timezone) this brief covers.
  date       DateTime      @unique @db.Date
  headline   String
  summary    String
  /// Structured sections: see src/server/brain/types.ts (BriefSections).
  sections   Json
  refreshId  String?
  refresh    BrainRefresh? @relation(fields: [refreshId], references: [id], onDelete: SetNull)
  reviewedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model InboxItem {
  id                String      @id @default(cuid())
  type              InboxType
  status            InboxStatus @default(OPEN)
  title             String
  summary           String?
  whyCeo            String
  recommendedAction String
  /// 1–5
  urgency           Int         @default(3)
  dueDate           DateTime?   @db.Date
  snoozedUntil      DateTime?
  resolvedAt        DateTime?
  resolution        String?
  source            ItemSource  @default(BRAIN)
  fingerprint       String?     @unique
  insightId         String?
  insight           BrainInsight? @relation(fields: [insightId], references: [id], onDelete: SetNull)
  personId          String?
  person            Person?     @relation(fields: [personId], references: [id], onDelete: SetNull)
  companyId         String?
  company           Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  taskId            String?
  task              Task?       @relation(fields: [taskId], references: [id], onDelete: SetNull)
  decisionId        String?
  decision          Decision?   @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  goalId            String?
  goal              Goal?       @relation(fields: [goalId], references: [id], onDelete: SetNull)
  dealId            String?
  deal              Deal?       @relation(fields: [dealId], references: [id], onDelete: SetNull)
  /// CEO attention engine output for ingestion-sourced items.
  attention          AttentionLevel?
  confidence         Confidence?
  strategicRelevance String?
  sourceItemId       String?
  sourceItem         SourceItem?  @relation(fields: [sourceItemId], references: [id], onDelete: SetNull)
  commitmentId       String?
  commitment         Commitment?  @relation(fields: [commitmentId], references: [id], onDelete: SetNull)
  riskId             String?
  risk               Risk?        @relation(fields: [riskId], references: [id], onDelete: SetNull)
  opportunityId      String?
  opportunity        Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status, urgency])
}

// ─────────────────────────────────────────────────────────────────────────────
// Daily operating rhythm, history & reviews
// ─────────────────────────────────────────────────────────────────────────────

/// One row per CEO working day: tracks the morning → evening workflow.
model DayPlan {
  id              String    @id @default(cuid())
  date            DateTime  @unique @db.Date
  briefReviewedAt DateTime?
  top5ConfirmedAt DateTime?
  endOfDayAt      DateTime?
  endOfDayNotes   String?
  intention       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  priorities DailyPriority[]
}

model DailyPriority {
  id        String         @id @default(cuid())
  dayPlanId String
  dayPlan   DayPlan        @relation(fields: [dayPlanId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  rank      Int
  score     Float
  rationale String?
  source    PrioritySource @default(BRAIN)
  pinned    Boolean        @default(false)
  createdAt DateTime       @default(now())

  @@unique([dayPlanId, taskId])
  @@index([dayPlanId, rank])
}

model Activity {
  id           String       @id @default(cuid())
  type         ActivityType
  summary      String
  /// "CEO", "CytoHub Brain", or a team member's name.
  actor        String       @default("CEO")
  metadata     Json?
  taskId       String?
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  goalId       String?
  goal         Goal?        @relation(fields: [goalId], references: [id], onDelete: SetNull)
  milestoneId  String?
  milestone    Milestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  decisionId   String?
  decision     Decision?    @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  meetingId    String?
  meeting      Meeting?     @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  companyId    String?
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  personId     String?
  person       Person?      @relation(fields: [personId], references: [id], onDelete: SetNull)
  delegationId String?
  delegation   Delegation?  @relation(fields: [delegationId], references: [id], onDelete: SetNull)
  sourceItemId  String?
  sourceItem    SourceItem?  @relation(fields: [sourceItemId], references: [id], onDelete: SetNull)
  commitmentId  String?
  commitment    Commitment?  @relation(fields: [commitmentId], references: [id], onDelete: SetNull)
  riskId        String?
  risk          Risk?        @relation(fields: [riskId], references: [id], onDelete: SetNull)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  documentId    String?
  document      Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())

  @@index([createdAt])
  @@index([type])
  @@index([commitmentId])
}

model Note {
  id          String     @id @default(cuid())
  body        String
  author      String     @default("CEO")
  taskId      String?
  task        Task?      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  goalId      String?
  goal        Goal?      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  decisionId  String?
  decision    Decision?  @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  meetingId   String?
  meeting     Meeting?   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  personId    String?
  person      Person?    @relation(fields: [personId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company?   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([createdAt])
}

model Review {
  id          String     @id @default(cuid())
  type        ReviewType
  periodStart DateTime   @db.Date
  periodEnd   DateTime   @db.Date
  whatWorked  String?
  whatDidnt   String?
  learned     String?
  changeNext  String?
  /// Frozen copy of the generated review at completion time.
  snapshot    Json?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([type, periodStart])
}

// ─────────────────────────────────────────────────────────────────────────────
// Chief of Staff conversations
// ─────────────────────────────────────────────────────────────────────────────

model ChatThread {
  id        String        @id @default(cuid())
  title     String
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  messages ChatMessage[]
}

model ChatMessage {
  id        String     @id @default(cuid())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      ChatRole
  content   String
  /// Entities the answer drew on: [{ type, id, label, href }]
  citations Json?
  /// "claude" or "brain-rules" — which engine produced the answer.
  engine    String?
  createdAt DateTime   @default(now())

  @@index([threadId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Security: roles, sessions, permissions, audit
// See docs/ingestion/ARCHITECTURE.md §10.
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  CEO
  EXECUTIVE
  TEAM_MEMBER
  ADMIN
  ADVISOR
}

/// Clearance ladder for source content: INTERNAL < CONFIDENTIAL < RESTRICTED.
enum Sensitivity {
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

enum GrantResource {
  CONNECTION
  SOURCE_ITEM
  DOCUMENT
  EMAIL_THREAD
}

model Session {
  id         String    @id @default(cuid())
  /// SHA-256 of the session token; the token itself only lives in the cookie.
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  ip         String?
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
}

/// Explicit access to a connection, source item, document or thread beyond role clearance.
model AccessGrant {
  id           String        @id @default(cuid())
  resourceType GrantResource
  resourceId   String
  /// Grant to one user …
  userId       String?
  user         User?         @relation("GrantUser", fields: [userId], references: [id], onDelete: Cascade)
  /// … or to every user with a role.
  role         UserRole?
  grantedById  String?
  grantedBy    User?         @relation("GrantGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  expiresAt    DateTime?

  @@index([resourceType, resourceId])
  @@index([userId])
}

model AuditLog {
  id          String       @id @default(cuid())
  at          DateTime     @default(now())
  actorUserId String?
  actor       User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  /// Email of the actor, or "system" / "CytoHub Brain".
  actorLabel  String
  /// Dotted action name, e.g. "auth.login", "source.view", "connection.disconnect".
  action      String
  outcome     AuditOutcome @default(SUCCESS)
  targetType  String?
  targetId    String?
  ip          String?
  userAgent   String?
  metadata    Json?

  @@index([at])
  @@index([action])
  @@index([actorUserId])
}

/// Fixed-window rate limiter state ("<scope>:<subject>:<window>").
model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Ingestion: connections, raw source items, email, calendar, documents
// ─────────────────────────────────────────────────────────────────────────────

enum SourceKind {
  EMAIL
  CALENDAR
  DOCUMENTS
}

enum SourceProvider {
  GMAIL
  OUTLOOK_MAIL
  GOOGLE_CALENDAR
  OUTLOOK_CALENDAR
  GOOGLE_DRIVE
  ONEDRIVE
  SHAREPOINT
  DROPBOX
  LOCAL_UPLOAD
  CYTOHUB_INTERNAL
}

/// LIVE = OAuth connection to the provider; DEMO = mock adapter over sample fixtures.
enum ConnectionMode {
  LIVE
  DEMO
}

enum ConnectionStatus {
  CONNECTED
  SYNCING
  ERROR
  NEEDS_REAUTH
  PAUSED
  DISCONNECTED
}

enum SyncFrequency {
  MANUAL
  HOURLY
  DAILY
  REALTIME
}

enum SourceItemKind {
  EMAIL_MESSAGE
  CALENDAR_EVENT
  DOCUMENT
  MEETING_NOTES
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  PROCESSED
  SKIPPED
  FAILED
}

/// Last pipeline stage a source item completed (processing resumes from here).
enum PipelineStage {
  RAW
  NORMALIZED
  PARSED
  ENTITIES_EXTRACTED
  ENTITIES_RESOLVED
  RELATIONSHIPS_MAPPED
  INTELLIGENCE_EXTRACTED
  WRITTEN
}

enum Relevance {
  CRITICAL
  HIGH
  NORMAL
  LOW
  NOISE
}

/// Why an item matters to the CEO (or why it does not).
enum CeoCategory {
  INVESTOR
  CUSTOMER
  STRATEGIC_PARTNER
  BOARD
  LEGAL
  FINANCE
  RECRUITING
  EXECUTIVE_TEAM
  SCIENTIFIC_LEADERSHIP
  MAJOR_VENDOR
  FUNDRAISING
  COMMERCIAL_OPPORTUNITY
  INTERNAL_ESCALATION
  OPERATIONS
  PERSONAL
  NEWSLETTER
  MARKETING
  NOTIFICATION
  SPAM
  OTHER
}

enum AttentionLevel {
  IMMEDIATE
  TODAY
  THIS_WEEK
  MONITOR
  DELEGATE
  ARCHIVE
}

enum Confidence {
  HIGH
  MEDIUM
  LOW
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum ReplyStatus {
  REPLIED
  AWAITING_CEO
  AWAITING_THEM
  NO_REPLY_NEEDED
}

enum ThreadStatus {
  AWAITING_CEO
  AWAITING_THEM
  ACTIVE
  FYI
  RESOLVED
}

enum EventStatus {
  CONFIRMED
  TENTATIVE
  CANCELLED
}

enum ResponseStatus {
  ACCEPTED
  DECLINED
  TENTATIVE
  NEEDS_ACTION
  ORGANIZER
}

enum MeetingCategory {
  INVESTOR
  CUSTOMER
  BOARD
  INTERNAL_LEADERSHIP
  SCIENTIFIC
  PARTNER
  RECRUITING
  LEGAL
  FINANCE
  PRODUCT
  SALES
  FUNDRAISING
  NETWORKING
  PERSONAL
  OTHER
}

enum MeetingStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum DocumentType {
  INVESTOR_DECK
  FINANCIAL_MODEL
  CUSTOMER_PROPOSAL
  CUSTOMER_CONTRACT
  NDA
  STRATEGIC_PLAN
  SCIENTIFIC_REPORT
  EXPERIMENT_REPORT
  PUBLICATION
  REGULATORY_DOCUMENT
  PRODUCT_SPECIFICATION
  MEETING_NOTES
  BOARD_DOCUMENT
  FUNDRAISING_MATERIAL
  SALES_MATERIAL
  EMPLOYEE_DOCUMENT
  LEGAL_DOCUMENT
  PARTNERSHIP_AGREEMENT
  SCIENTIFIC_DATA_SUMMARY
  INTERNAL_MEMO
  OTHER
}

enum DocumentFormat {
  PDF
  DOCX
  PPTX
  XLSX
  CSV
  TXT
  MARKDOWN
  HTML
  IMAGE
  OTHER
}

/// A connected account (mailbox, calendar, drive) belonging to a BrainSource catalog entry.
model SourceConnection {
  id                  String           @id @default(cuid())
  kind                SourceKind
  provider            SourceProvider
  mode                ConnectionMode   @default(LIVE)
  label               String
  accountEmail        String?
  externalAccountId   String?
  status              ConnectionStatus @default(CONNECTED)
  syncFrequency       SyncFrequency    @default(HOURLY)
  scopes              String[]
  /// AES-256-GCM encrypted JSON token set. Never sent to the client.
  credentials         String?
  tokenExpiresAt      DateTime?
  /// Provider cursor: { historyId } · { syncToken } · { deltaLink } · { pageToken } · { modifiedSince } …
  cursor              Json?
  lastSyncAt          DateTime?
  lastSuccessAt       DateTime?
  lastErrorAt         DateTime?
  lastError           String?
  consecutiveFailures Int              @default(0)
  nextSyncAt          DateTime?
  webhookChannelId    String?
  /// SHA-256 of the per-connection webhook secret (provider echoes the secret).
  webhookSecretHash   String?
  webhookExpiresAt    DateTime?
  /// Ingest newsletters / notifications too (off by default).
  includeNoise        Boolean          @default(false)
  defaultSensitivity  Sensitivity      @default(CONFIDENTIAL)
  /// Provider options: folders/labels to include, demo anchor time, drive ids…
  settings            Json?
  itemsIngested       Int              @default(0)
  ownerUserId         String?
  owner               User?            @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  brainSourceId       String?
  brainSource         BrainSource?     @relation(fields: [brainSourceId], references: [id], onDelete: SetNull)
  disconnectedAt      DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  items   SourceItem[]
  threads EmailThread[]
  runs    IngestionRun[]
  jobs    IngestionJob[]

  @@index([kind, status])
}

/// One ingested message, event, document or notes item: the provenance anchor
/// for everything the Brain derives from it.
model SourceItem {
  id               String           @id @default(cuid())
  connectionId     String
  connection       SourceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  kind             SourceItemKind
  externalId       String
  externalUrl      String?
  title            String
  /// When it happened: sent, starts, last modified.
  occurredAt       DateTime
  ingestedAt       DateTime         @default(now())
  sourceUpdatedAt  DateTime?
  /// SHA-256 of normalized content; unchanged content is not reprocessed.
  contentHash      String
  version          Int              @default(1)
  /// Encrypted original provider payload (retention-managed).
  rawPayload       String?
  /// Normalized plain text for extraction and search (retention-managed).
  text             String?
  snippet          String?
  status           ProcessingStatus @default(PENDING)
  stage            PipelineStage    @default(RAW)
  attempts         Int              @default(0)
  processingError  String?
  processedAt      DateTime?
  relevance        Relevance?
  relevanceScore   Float?
  category         CeoCategory?
  relevanceReasons String[]
  attention        AttentionLevel?
  sensitivity      Sensitivity      @default(CONFIDENTIAL)
  /// Intermediate stage outputs so a retried stage resumes where it stopped.
  stageData        Json?
  /// Validated intelligence extraction (retention-managed).
  extraction       Json?
  extractionEngine String?
  extractedAt      DateTime?
  /// Same message seen through another connection (RFC 5322 Message-ID match).
  duplicateOfId    String?
  duplicateOf      SourceItem?      @relation("SourceDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates       SourceItem[]     @relation("SourceDuplicates")
  /// Meeting notes belong to a meeting.
  meetingId        String?
  meeting          Meeting?         @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  deletedAtSource  DateTime?
  contentPurgedAt  DateTime?
  /// Full-text index, maintained by a trigger (see migration).
  searchVector     Unsupported("tsvector")?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  emailMessage  EmailMessage?
  calendarEvent CalendarEvent?
  document      Document?
  mentions      EntityMention[]
  references    SourceReference[]
  relationships Relationship[]
  reviewItems   ReviewQueueItem[]
  jobs          IngestionJob[]
  insights      BrainInsight[]
  inboxItems    InboxItem[]
  activities    Activity[]

  @@unique([connectionId, externalId])
  @@index([kind, occurredAt])
  @@index([status])
  @@index([relevance])
  @@index([searchVector], type: Gin)
}

/// A conversation, with an evolving summary maintained as messages arrive.
model EmailThread {
  id                 String           @id @default(cuid())
  connectionId       String
  connection         SourceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  externalThreadId   String
  subject            String
  firstMessageAt     DateTime
  lastMessageAt      DateTime
  lastInboundAt      DateTime?
  lastOutboundAt     DateTime?
  messageCount       Int              @default(0)
  /// [{ name, email, personId?, companyId? }]
  participants       Json
  relevance          Relevance?
  category           CeoCategory?
  sensitivity        Sensitivity      @default(CONFIDENTIAL)
  status             ThreadStatus     @default(ACTIVE)
  awaitingSince      DateTime?
  summary            String?
  currentStatus      String?
  /// [{ name, role, personId? }]
  keyParticipants    Json?
  openQuestions      String[]
  decisionsSummary   String[]
  nextStep           String?
  recommendedAction  String?
  summaryEngine      String?
  summarizedAt       DateTime?
  summarizedMessages Int              @default(0)
  companyId          String?
  company            Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  dealId             String?
  deal               Deal?            @relation(fields: [dealId], references: [id], onDelete: SetNull)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  messages    EmailMessage[]
  commitments Commitment[]
  events      CalendarEvent[]

  @@unique([connectionId, externalThreadId])
  @@index([lastMessageAt])
  @@index([status])
}

model EmailMessage {
  id                String           @id @default(cuid())
  sourceItemId      String           @unique
  sourceItem        SourceItem       @relation(fields: [sourceItemId], references: [id], onDelete: Cascade)
  threadId          String
  thread            EmailThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  externalMessageId String
  /// RFC 5322 Message-ID; detects the same message across providers.
  internetMessageId String?
  inReplyTo         String?
  fromName          String?
  fromEmail         String
  /// [{ name, email }]
  to                Json
  cc                Json
  bcc               Json?
  subject           String
  sentAt            DateTime
  direction         MessageDirection
  labels            String[]
  folder            String?
  isRead            Boolean?
  /// Newsletters, notifications, no-reply senders, List-Unsubscribe.
  isAutomated       Boolean          @default(false)
  hasAttachments    Boolean          @default(false)
  replyStatus       ReplyStatus      @default(NO_REPLY_NEEDED)
  createdAt         DateTime         @default(now())

  attachments EmailAttachment[]

  @@index([threadId, sentAt])
  @@index([internetMessageId])
  @@index([fromEmail])
}

model EmailAttachment {
  id                   String       @id @default(cuid())
  messageId            String
  message              EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  externalAttachmentId String?
  filename             String
  mimeType             String
  sizeBytes            Int
  contentHash          String?
  blobId               String?
  blob                 StoredBlob?  @relation(fields: [blobId], references: [id], onDelete: SetNull)
  documentId           String?
  document             Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdAt            DateTime     @default(now())
}

model CalendarEvent {
  id               String           @id @default(cuid())
  sourceItemId     String           @unique
  sourceItem       SourceItem       @relation(fields: [sourceItemId], references: [id], onDelete: Cascade)
  externalEventId  String
  iCalUid          String?
  /// Recurring series id (instances share it).
  seriesId         String?
  title            String
  description      String?
  startsAt         DateTime
  endsAt           DateTime
  allDay           Boolean          @default(false)
  timezone         String?
  location         String?
  conferenceUrl    String?
  organizerName    String?
  organizerEmail   String?
  /// [{ name, email, responseStatus, optional, personId? }]
  attendees        Json
  isRecurring      Boolean          @default(false)
  recurrence       String?
  status           EventStatus      @default(CONFIRMED)
  ceoResponse      ResponseStatus?
  category         MeetingCategory?
  /// 1–5
  importance       Int              @default(3)
  /// Start time before the most recent reschedule.
  previousStartsAt DateTime?
  meetingId        String?          @unique
  meeting          Meeting?         @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  relatedThreadId  String?
  relatedThread    EmailThread?     @relation(fields: [relatedThreadId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([startsAt])
}

model Document {
  id                String         @id @default(cuid())
  sourceItemId      String         @unique
  sourceItem        SourceItem     @relation(fields: [sourceItemId], references: [id], onDelete: Cascade)
  title             String
  docType           DocumentType   @default(OTHER)
  docTypeConfidence Float?
  format            DocumentFormat
  mimeType          String
  author            String?
  createdAtSource   DateTime?
  modifiedAtSource  DateTime?
  url               String?
  path              String?
  sizeBytes         Int?
  currentVersion    Int            @default(1)
  contentHash       String
  summary           String?
  /// Latest key facts ([{ label, value, kind }]) used for version diffs.
  keyFacts          Json?
  sensitivity       Sensitivity    @default(CONFIDENTIAL)
  /// Mirrors the document into the Resource Center.
  resourceId        String?        @unique
  resource          Resource?      @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  companyId         String?
  company           Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  projectId         String?
  project           Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  versions    DocumentVersion[]
  attachments EmailAttachment[]
  insights    BrainInsight[]
  activities  Activity[]

  @@index([docType])
}

model DocumentVersion {
  id                 String           @id @default(cuid())
  documentId         String
  document           Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version            Int
  modifiedAt         DateTime
  contentHash        String
  previousVersionId  String?          @unique
  previousVersion    DocumentVersion? @relation("VersionChain", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersion        DocumentVersion? @relation("VersionChain")
  /// Extracted text (retention-managed).
  text               String?
  textLength         Int              @default(0)
  pageCount          Int?
  parser             String
  /// Encrypted raw copy (retention-managed).
  blobId             String?
  blob               StoredBlob?      @relation(fields: [blobId], references: [id], onDelete: SetNull)
  changeSummary      String?
  /// [{ label, from, to, kind, significance }]
  significantChanges Json?
  isSignificant      Boolean          @default(false)
  keyFacts           Json?
  createdAt          DateTime         @default(now())

  @@unique([documentId, version])
}

/// Encrypted binary store for attachments and raw document copies (dedupe by hash).
model StoredBlob {
  id        String    @id @default(cuid())
  sha256    String    @unique
  sizeBytes Int
  mimeType  String
  /// AES-256-GCM ciphertext; null once purged by retention.
  data      Bytes?
  createdAt DateTime  @default(now())
  purgedAt  DateTime?

  attachments EmailAttachment[]
  versions    DocumentVersion[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Intelligence: commitments, risks, opportunities, projects, graph, provenance
// ─────────────────────────────────────────────────────────────────────────────

/// OUTBOUND: CytoHub / the CEO owes it. INBOUND: someone owes CytoHub.
enum CommitmentDirection {
  OUTBOUND
  INBOUND
  INTERNAL
}

/// OVERDUE is derived (OPEN and due before today).
enum CommitmentStatus {
  OPEN
  FULFILLED
  CANCELLED
  SUPERSEDED
}

enum RiskStatus {
  OPEN
  MONITORING
  MITIGATED
  RESOLVED
  ACCEPTED
}

enum OpportunityKind {
  COMMERCIAL
  FUNDRAISING
  PARTNERSHIP
  SCIENTIFIC
  EXPANSION
  HIRING
  OTHER
}

enum OpportunityStatus {
  OPEN
  PURSUING
  WON
  LOST
  DISMISSED
}

enum ProjectKind {
  PROJECT
  SCIENTIFIC_PROGRAM
  PRODUCT
}

enum EntityType {
  PERSON
  COMPANY
  PROJECT
  GOAL
  MILESTONE
  TASK
  DECISION
  MEETING
  DEAL
  DOCUMENT
  EMAIL_THREAD
  SOURCE_ITEM
  COMMITMENT
  RISK
  OPPORTUNITY
  RESOURCE
  INSIGHT
  INBOX_ITEM
}

enum AliasKind {
  NAME
  NICKNAME
  ABBREVIATION
  EMAIL
  DOMAIN
  SUBSIDIARY
  FORMER_NAME
}

enum AliasSource {
  SYSTEM
  SEED
  LEARNED
  USER
}

enum MentionRole {
  SENDER
  RECIPIENT
  CC
  ORGANIZER
  ATTENDEE
  AUTHOR
  MENTIONED
}

enum MentionResolution {
  RESOLVED
  CREATED
  AMBIGUOUS
  UNRESOLVED
  IGNORED
}

enum RelationType {
  WORKS_AT
  SUBSIDIARY_OF
  ASSOCIATED_WITH
  CAME_FROM
  RELATED_TO
  SUPPORTS
  ORIGINATED_FROM
  AFFECTS
  MADE_BY
  OWED_TO
  MENTIONS
  ATTENDED
  AUTHORED
  ABOUT
  INVESTS_IN
  CUSTOMER_OF
  PARTNER_OF
}

enum ReferenceRole {
  CREATED_FROM
  UPDATED_FROM
  CORROBORATED_BY
}

enum ReviewKind {
  TASK
  COMMITMENT
  DEADLINE
  DECISION
  RISK
  OPPORTUNITY
  MEETING
  ENTITY_MERGE
  NEW_PERSON
  NEW_COMPANY
  NEW_INVESTOR
  FIELD_CHANGE
  DOCUMENT_CHANGE
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  MERGED
  IGNORED
}

model Commitment {
  id                   String              @id @default(cuid())
  direction            CommitmentDirection
  status               CommitmentStatus    @default(OPEN)
  /// Short action, e.g. "Send revised data package".
  title                String
  /// The commitment as written.
  text                 String
  dueDate              DateTime?           @db.Date
  /// The original phrasing of the deadline ("by Friday").
  dueText              String?
  followUpDate         DateTime?           @db.Date
  committedAt          DateTime
  fulfilledAt          DateTime?
  resolutionNote       String?
  confidence           Confidence
  confidenceScore      Float
  fingerprint          String              @unique
  /// Who must deliver (the CEO for CEO commitments; the other party for inbound ones).
  ownerPersonId        String?
  owner                Person?             @relation("CommitmentOwner", fields: [ownerPersonId], references: [id], onDelete: SetNull)
  /// Who it is owed to.
  counterpartyPersonId String?
  counterparty         Person?             @relation("CommitmentCounterparty", fields: [counterpartyPersonId], references: [id], onDelete: SetNull)
  companyId            String?
  company              Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  /// CEO commitments are mirrored as a task so they are scored and can enter the Top 5.
  taskId               String?             @unique
  task                 Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  threadId             String?
  thread               EmailThread?        @relation(fields: [threadId], references: [id], onDelete: SetNull)
  meetingId            String?
  meeting              Meeting?            @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  dealId               String?
  deal                 Deal?               @relation(fields: [dealId], references: [id], onDelete: SetNull)
  goalId               String?
  goal                 Goal?               @relation(fields: [goalId], references: [id], onDelete: SetNull)
  opportunityId        String?
  opportunity          Opportunity?        @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  projectId            String?
  project              Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  insights   BrainInsight[]
  inboxItems InboxItem[]
  activities Activity[]

  @@index([direction, status, dueDate])
  @@index([companyId])
}

model Risk {
  id              String     @id @default(cuid())
  title           String
  description     String?
  /// COMMERCIAL, FUNDRAISING, SCIENTIFIC, LEGAL, OPERATIONAL, PEOPLE, FINANCIAL, REGULATORY, CUSTOMER
  category        String?
  /// 1–5
  severity        Int        @default(3)
  /// 1–5
  likelihood      Int?
  status          RiskStatus @default(OPEN)
  mitigation      String?
  identifiedAt    DateTime
  resolvedAt      DateTime?
  resolution      String?
  confidence      Confidence
  confidenceScore Float
  fingerprint     String     @unique
  ownerPersonId   String?
  owner           Person?    @relation("RiskOwner", fields: [ownerPersonId], references: [id], onDelete: SetNull)
  companyId       String?
  company         Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  goalId          String?
  goal            Goal?      @relation(fields: [goalId], references: [id], onDelete: SetNull)
  milestoneId     String?
  milestone       Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  dealId          String?
  deal            Deal?      @relation(fields: [dealId], references: [id], onDelete: SetNull)
  projectId       String?
  project         Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  insights   BrainInsight[]
  inboxItems InboxItem[]
  activities Activity[]

  @@index([status, severity])
}

model Opportunity {
  id              String            @id @default(cuid())
  title           String
  description     String?
  kind            OpportunityKind
  status          OpportunityStatus @default(OPEN)
  /// USD
  estimatedValue  Float?
  nextStep        String?
  identifiedAt    DateTime
  closedAt        DateTime?
  confidence      Confidence
  confidenceScore Float
  fingerprint     String            @unique
  companyId       String?
  company         Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  personId        String?
  person          Person?           @relation("OpportunityContact", fields: [personId], references: [id], onDelete: SetNull)
  dealId          String?
  deal            Deal?             @relation(fields: [dealId], references: [id], onDelete: SetNull)
  goalId          String?
  goal            Goal?             @relation(fields: [goalId], references: [id], onDelete: SetNull)
  projectId       String?
  project         Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  commitments Commitment[]
  insights    BrainInsight[]
  inboxItems  InboxItem[]
  activities  Activity[]

  @@index([status])
}

/// Canonical projects, scientific programs and products (aliases in EntityAlias).
model Project {
  id          String           @id @default(cuid())
  name        String           @unique
  kind        ProjectKind
  description String?
  status      String?
  goalId      String?
  goal        Goal?            @relation(fields: [goalId], references: [id], onDelete: SetNull)
  pillarId    String?
  pillar      StrategicPillar? @relation(fields: [pillarId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  documents     Document[]
  commitments   Commitment[]
  risks         Risk[]
  opportunities Opportunity[]
}

/// Alternate names, emails, domains and abbreviations for canonical entities.
model EntityAlias {
  id         String      @id @default(cuid())
  entityType EntityType
  entityId   String
  alias      String
  /// Lower-cased, punctuation- and title-stripped form used for matching.
  normalized String
  kind       AliasKind
  confidence Float       @default(1)
  source     AliasSource @default(SYSTEM)
  createdAt  DateTime    @default(now())

  @@unique([entityType, entityId, normalized])
  @@index([normalized])
}

/// A reference to a person, company or project inside a source item.
model EntityMention {
  id           String            @id @default(cuid())
  sourceItemId String
  sourceItem   SourceItem        @relation(fields: [sourceItemId], references: [id], onDelete: Cascade)
  entityType   EntityType
  entityId     String?
  text         String
  normalized   String
  email        String?
  role         MentionRole       @default(MENTIONED)
  /// 0–1
  confidence   Float
  resolution   MentionResolution @default(UNRESOLVED)
  /// [{ entityId, label, score }] when ambiguous.
  candidates   Json?
  createdAt    DateTime          @default(now())

  @@index([sourceItemId])
  @@index([entityType, entityId])
}

/// Typed, evidence-backed edge in the company knowledge graph.
model Relationship {
  id            String       @id @default(cuid())
  fromType      EntityType
  fromId        String
  relation      RelationType
  toType        EntityType
  toId          String
  /// 0–1
  confidence    Float        @default(1)
  evidenceCount Int          @default(1)
  sourceItemId  String?
  sourceItem    SourceItem?  @relation(fields: [sourceItemId], references: [id], onDelete: SetNull)
  firstSeenAt   DateTime     @default(now())
  lastSeenAt    DateTime     @default(now())
  validTo       DateTime?
  metadata      Json?

  @@unique([fromType, fromId, relation, toType, toId])
  @@index([fromType, fromId])
  @@index([toType, toId])
}

/// Provenance: which source produced (or corroborated) an intelligence record.
/// Snapshot fields keep traceability even after content is purged.
model SourceReference {
  id               String         @id @default(cuid())
  targetType       EntityType
  targetId         String
  role             ReferenceRole  @default(CREATED_FROM)
  sourceItemId     String?
  sourceItem       SourceItem?    @relation(fields: [sourceItemId], references: [id], onDelete: SetNull)
  sourceKind       SourceItemKind
  provider         SourceProvider
  sourceTitle      String
  sourceExternalId String?
  sourceUrl        String?
  sourceOccurredAt DateTime
  excerpt          String?
  confidence       Float?
  engine           String?
  ingestedAt       DateTime
  createdAt        DateTime       @default(now())

  @@unique([targetType, targetId, sourceItemId, role])
  @@index([targetType, targetId])
  @@index([sourceItemId])
}

/// Uncertain or high-impact AI conclusions awaiting a human decision.
model ReviewQueueItem {
  id               String       @id @default(cuid())
  kind             ReviewKind
  status           ReviewStatus @default(PENDING)
  title            String
  /// Why this needs a human (shown to the reviewer).
  reason           String
  /// 1–5
  impact           Int          @default(3)
  confidence       Confidence
  confidenceScore  Float
  /// Validated proposal the writer applies on approval (shape per kind).
  proposal         Json
  /// Reviewer's edited proposal when approved with edits.
  edited           Json?
  /// Existing record the proposal updates or merges into.
  targetType       EntityType?
  targetId         String?
  /// Merge / match candidates: [{ entityId, label, score }]
  candidates       Json?
  excerpt          String?
  fingerprint      String       @unique
  sensitivity      Sensitivity  @default(CONFIDENTIAL)
  sourceItemId     String?
  sourceItem       SourceItem?  @relation(fields: [sourceItemId], references: [id], onDelete: SetNull)
  assignedToUserId String?
  assignedTo       User?        @relation("ReviewAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  resolvedByUserId String?
  resolvedBy       User?        @relation("ReviewResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  resolvedAt       DateTime?
  resolutionNote   String?
  resultType       EntityType?
  resultId         String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([status, impact])
  @@index([kind])
}

// ─────────────────────────────────────────────────────────────────────────────
// Ingestion jobs & runs (observability)
// ─────────────────────────────────────────────────────────────────────────────

enum JobType {
  EMAIL_SYNC
  CALENDAR_SYNC
  DOCUMENT_SYNC
  DOCUMENT_PARSE
  ENTITY_EXTRACTION
  ENTITY_RESOLUTION
  RELATIONSHIP_MAPPING
  INTELLIGENCE_EXTRACTION
  BRAIN_WRITE
  THREAD_SUMMARY
  PRIORITY_RECALC
  DAILY_BRAIN_REFRESH
  RETENTION_SWEEP
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  DEAD
  CANCELLED
}

enum RunStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum RunTrigger {
  MANUAL
  SCHEDULED
  WEBHOOK
  REFRESH
  SEED
  UPLOAD
}

/// Postgres-backed work queue (claimed with FOR UPDATE SKIP LOCKED).
model IngestionJob {
  id           String            @id @default(cuid())
  type         JobType
  status       JobStatus         @default(QUEUED)
  /// Higher runs first.
  priority     Int               @default(0)
  payload      Json?
  /// Idempotency key while queued/running; cleared when the job finishes.
  dedupeKey    String?           @unique
  runAt        DateTime          @default(now())
  attempts     Int               @default(0)
  maxAttempts  Int               @default(5)
  lockedAt     DateTime?
  lockedBy     String?
  startedAt    DateTime?
  completedAt  DateTime?
  durationMs   Int?
  lastError    String?
  result       Json?
  connectionId String?
  connection   SourceConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  sourceItemId String?
  sourceItem   SourceItem?       @relation(fields: [sourceItemId], references: [id], onDelete: Cascade)
  runId        String?
  run          IngestionRun?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status, runAt, priority])
  @@index([type, status])
  @@index([runId])
}

/// One sync of one connection (or a pipeline drain), with stage counters.
model IngestionRun {
  id                  String            @id @default(cuid())
  connectionId        String?
  connection          SourceConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  trigger             RunTrigger
  status              RunStatus         @default(RUNNING)
  startedAt           DateTime          @default(now())
  completedAt         DateTime?
  durationMs          Int?
  cursorBefore        Json?
  cursorAfter         Json?
  fetched             Int               @default(0)
  created             Int               @default(0)
  updated             Int               @default(0)
  unchanged           Int               @default(0)
  deleted             Int               @default(0)
  noise               Int               @default(0)
  failed              Int               @default(0)
  duplicatesPrevented Int               @default(0)
  recordsWritten      Int               @default(0)
  reviewItems         Int               @default(0)
  extractionErrors    Int               @default(0)
  error               String?
  log                 Json?

  jobs IngestionJob[]

  @@index([startedAt])
  @@index([connectionId, startedAt])
}
