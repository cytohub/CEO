# PostgreSQL connection (required)
DATABASE_URL="postgresql://cytohub:cytohub@localhost:5432/cytohub_ceo?schema=public"

# Optional — enables Claude for the Chief of Staff, Prepare Me and brief narratives.
# Without it, CytoHub Brain answers with its deterministic rules engine.
ANTHROPIC_API_KEY=
# CYTOHUB_CLAUDE_MODEL=claude-opus-5-5
# CYTOHUB_CHIEF_EFFORT=medium

# Protects the cron endpoints (/api/brain/refresh, /api/ingestion/tick).
CRON_SECRET=

# ── Security ─────────────────────────────────────────────────────────────────
# REQUIRED in production: 32-byte key for AES-256-GCM encryption of OAuth
# tokens, raw source payloads and stored documents. Generate: openssl rand -base64 32
CYTOHUB_ENCRYPTION_KEY=
# During key rotation, the previous key (reads fall back to it).
# CYTOHUB_ENCRYPTION_KEY_PREVIOUS=
# Public origin(s) of the app, comma-separated (OAuth redirects, CSRF checks).
# APP_ORIGIN=https://ceo.cytohub.com
# Override the Secure flag on the session cookie (defaults to true in production).
# SESSION_COOKIE_SECURE=true

# Seed defaults
# CEO_NAME=CEO
# SEED_TIMEZONE=America/New_York
# Password for the seeded accounts (a random one is generated and printed if unset).
# SEED_PASSWORD=

# Connectors (CytoHub Brain sources) — set to activate each integration.
# MS365_TENANT_ID= MS365_CLIENT_ID= MS365_CLIENT_SECRET=
# HUBSPOT_ACCESS_TOKEN=
# GRANOLA_API_KEY=
# READ_AI_API_KEY=
# DOCUSIGN_ACCESS_TOKEN=
# FINANCE_API_KEY=
# ELN_API_KEY=
# HRIS_API_KEY=
