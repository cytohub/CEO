# PostgreSQL connection (required)
DATABASE_URL="postgresql://cytohub:cytohub@localhost:5432/cytohub_ceo?schema=public"

# Optional — enables Claude for the Chief of Staff, Prepare Me and brief narratives.
# Without it, CytoHub Brain answers with its deterministic rules engine.
ANTHROPIC_API_KEY=
# CYTOHUB_CLAUDE_MODEL=claude-opus-5-5
# CYTOHUB_CHIEF_EFFORT=medium

# Protects the cron endpoints (/api/brain/refresh, /api/ingestion/tick).
CRON_SECRET=

# ── Security ─────────────────────────────────────────────────────────────────
# REQUIRED in production: 32-byte key for AES-256-GCM encryption of OAuth
# tokens, raw source payloads and stored documents. Generate: openssl rand -base64 32
CYTOHUB_ENCRYPTION_KEY=
# During key rotation, the previous key (reads fall back to it).
# CYTOHUB_ENCRYPTION_KEY_PREVIOUS=
# Public origin(s) of the app, comma-separated (OAuth redirects, CSRF checks).
# APP_ORIGIN=https://ceo.cytohub.com
# Override the Secure flag on the session cookie (defaults to true in production).
# SESSION_COOKIE_SECURE=true

# Seed defaults
# CEO_NAME=CEO
# SEED_TIMEZONE=America/New_York
# Password for the seeded accounts (a random one is generated and printed if unset).
# SEED_PASSWORD=

# ── Ingestion sources (OAuth apps) ───────────────────────────────────────────
# Without these, Settings → Integrations offers demo accounts only.
# Redirect URIs to register: <APP_ORIGIN>/api/integrations/{google|microsoft|dropbox}/callback
# Google: Gmail, Google Calendar, Google Drive (read-only scopes)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional Gmail push: Pub/Sub topic + a token appended to the push endpoint
# (<APP_ORIGIN>/api/webhooks/google?token=<GOOGLE_PUBSUB_VERIFICATION_TOKEN>)
# GOOGLE_PUBSUB_TOPIC=
# GOOGLE_PUBSUB_VERIFICATION_TOKEN=
# Microsoft 365: Outlook Mail, Outlook Calendar, OneDrive, SharePoint
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common
# Dropbox (the app secret also verifies webhook signatures; register /api/webhooks/dropbox)
# DROPBOX_APP_KEY=
# DROPBOX_APP_SECRET=

# Direct browser uploads, in MB (default 25). On Vercel, whose functions accept
# request bodies up to 4.5 MB, set this to 4.
# NEXT_PUBLIC_UPLOAD_MAX_MB=

# Other Brain connectors (CRM, notes, finance…) — set to activate each integration.
# HUBSPOT_ACCESS_TOKEN=
# GRANOLA_API_KEY=
# READ_AI_API_KEY=
# DOCUSIGN_ACCESS_TOKEN=
# FINANCE_API_KEY=
# ELN_API_KEY=
# HRIS_API_KEY=
