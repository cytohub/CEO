# CytoHub CEO Command Center on Lightsail. Copy to .env (readable only by you),
# fill in, and keep a copy of the secrets in your password manager.

# The public name, without https://
DOMAIN=ceo.cytolab.ai

# Database logins (take effect when the database is first created).
# Generate each with: openssl rand -hex 24
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# Encrypts OAuth tokens and stored documents: openssl rand -base64 32
# If it is lost, connected accounts must be reconnected.
CYTOHUB_ENCRYPTION_KEY=
# Protects the cron endpoints: openssl rand -hex 32
CRON_SECRET=

# Optional: Claude for extraction, the Chief of Staff and the brief narrative.
ANTHROPIC_API_KEY=

# The CEO's timezone, used when creating the first account.
DEFAULT_TIMEZONE=America/New_York

# Email, calendar and document sources (see docs/DEPLOYMENT.md, step 7).
# Redirect URIs: https://<DOMAIN>/api/integrations/{google|microsoft|dropbox}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_VERIFICATION_TOKEN=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
