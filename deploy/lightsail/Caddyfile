{
	# The admin API is only for live config reloads; restart the container instead.
	admin off
}

# Caddy gets and renews the Let's Encrypt certificate on its own, once DNS
# points the name at this server.
{$DOMAIN} {
	encode zstd gzip
	header {
		# Also on Caddy's own redirects and error pages; the app sets it on its responses.
		?Strict-Transport-Security "max-age=63072000; includeSubDomains"
		-Server
	}
	reverse_proxy web:3000 {
		# The visitor's address. Caddy also replaces any X-Forwarded-For the
		# client sent, so sign-in rate limits and the audit log can trust it.
		header_up X-Real-IP {remote_host}
	}
}
